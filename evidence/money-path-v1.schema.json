{
  "type": "object",
  "properties": {
    "$schema": {
      "const": "money-path-v1.schema.json"
    },
    "version": {
      "const": "flop-money-path-v1"
    },
    "source": {
      "type": "object",
      "properties": {
        "yellowpaper_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "yellowpaper_path": {
          "const": "whitepaper/yellowpaper.md"
        }
      },
      "required": [
        "yellowpaper_commit",
        "yellowpaper_path"
      ],
      "additionalProperties": false
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "family": {
            "enum": [
              "htlc-redeem",
              "cooperative-settle",
              "rent-ceil",
              "force-finalize",
              "da-loss-terminal",
              "non-delivery-timeout"
            ]
          },
          "status": {
            "enum": [
              "landed",
              "pending"
            ]
          },
          "decision": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^D-[0-9]{4}$"
              },
              "owner": {
                "type": "string",
                "pattern": "^https://github.com/flop-labs/flop-core/issues/[0-9]+$"
              },
              "requirements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "owner",
              "requirements"
            ],
            "additionalProperties": false
          },
          "source_issue": {
            "type": "string",
            "pattern": "^https://github.com/flop-labs/(yellowpaper|flop-core)/issues/[0-9]+$"
          },
          "adapter": {
            "enum": [
              "compute-channel",
              null
            ]
          },
          "input": {
            "type": "object",
            "minProperties": 1
          },
          "extrinsics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "call": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "type": "string",
                  "minLength": 1
                },
                "at_block": {
                  "type": "integer",
                  "minimum": 1
                },
                "args": {
                  "type": "object"
                }
              },
              "required": [
                "call",
                "origin",
                "at_block",
                "args"
              ],
              "additionalProperties": false
            }
          },
          "expected": {
            "type": "object",
            "properties": {
              "result": {
                "enum": [
                  "Ok",
                  "TariffExceedsEscrow"
                ]
              },
              "balances": {
                "type": "object",
                "properties": {
                  "agent": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "miner": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "challenger": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "pallet": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  }
                },
                "required": [
                  "agent",
                  "miner",
                  "challenger",
                  "pallet"
                ],
                "additionalProperties": false
              },
              "issuance_burned": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "storage": {
                "type": "object",
                "properties": {
                  "channel_state": {
                    "enum": [
                      "Open",
                      "Closed"
                    ]
                  },
                  "settlement_tariff_pay": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "total_escrow_reserved": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "total_miner_paid": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "total_refunded": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "total_burned": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "total_audit_earmarked": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "total_gn_credited": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  }
                },
                "required": [
                  "channel_state",
                  "settlement_tariff_pay",
                  "total_escrow_reserved",
                  "total_miner_paid",
                  "total_refunded",
                  "total_burned",
                  "total_audit_earmarked",
                  "total_gn_credited"
                ],
                "additionalProperties": false
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "result",
              "balances",
              "issuance_burned",
              "storage",
              "events"
            ],
            "additionalProperties": false
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "family",
          "status",
          "decision",
          "source_issue",
          "adapter",
          "input",
          "extrinsics"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pending"
                }
              }
            },
            "then": {
              "required": [
                "alternatives"
              ],
              "not": {
                "required": [
                  "expected"
                ]
              },
              "properties": {
                "adapter": {
                  "type": "null"
                },
                "decision": {
                  "properties": {
                    "id": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "landed"
                }
              }
            },
            "then": {
              "required": [
                "expected"
              ],
              "not": {
                "required": [
                  "alternatives"
                ]
              },
              "properties": {
                "adapter": {
                  "const": "compute-channel"
                },
                "family": {
                  "enum": [
                    "force-finalize",
                    "non-delivery-timeout"
                  ]
                },
                "decision": {
                  "properties": {
                    "id": {
                      "const": "D-0422"
                    }
                  }
                },
                "input": {
                  "type": "object",
                  "properties": {
                    "balances": {
                      "type": "object",
                      "properties": {
                        "agent": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)$"
                        },
                        "miner": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)$"
                        },
                        "challenger": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)$"
                        },
                        "pallet": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)$"
                        }
                      },
                      "required": [
                        "agent",
                        "miner",
                        "challenger",
                        "pallet"
                      ],
                      "additionalProperties": false
                    },
                    "storage": {
                      "type": "object",
                      "properties": {
                        "channel_state": {
                          "const": "Open"
                        },
                        "escrow": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)$"
                        }
                      },
                      "required": [
                        "channel_state",
                        "escrow"
                      ],
                      "additionalProperties": false
                    },
                    "profile": {
                      "type": "object",
                      "properties": {
                        "audit_fee_split_ppm": {
                          "const": 0
                        },
                        "base_per_turn": {
                          "const": "1"
                        },
                        "rate_g": {
                          "const": "1"
                        },
                        "phi_percent": {
                          "const": 20
                        },
                        "da_status": {
                          "const": "Available"
                        }
                      },
                      "required": [
                        "audit_fee_split_ppm",
                        "base_per_turn",
                        "rate_g",
                        "phi_percent",
                        "da_status"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "balances",
                    "storage",
                    "profile"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "$schema",
    "version",
    "source",
    "vectors"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLOP money-path state-transition vectors (partial conformance)"
}
