              "anyOf": [
                {
                  "required": [
                    "alternatives"
                  ]
                },
                {
                  "required": [
                    "pending_reason"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "landed"
                }
              }
            },
            "then": {
              "required": [
                "expected"
