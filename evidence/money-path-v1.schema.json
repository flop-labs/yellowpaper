{
  "type": "object",
  "properties": {
    "$schema": {
      "const": "money-path-v1.schema.json"
    },
    "version": {
      "const": "flop-money-path-v1"
    },
    "source": {
      "type": "object",
      "properties": {
        "yellowpaper_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "yellowpaper_path": {
          "const": "whitepaper/yellowpaper.md"
        }
      },
      "required": [
        "yellowpaper_commit",
        "yellowpaper_path"
      ],
      "additionalProperties": false
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "family": {
            "enum": [
              "htlc-redeem",
              "cooperative-settle",
              "rent-ceil",
              "force-finalize",
              "da-loss-terminal",
              "non-delivery-timeout",
              "reservation-slot-release",
              "lease-withdrawal"
            ]
          },
          "status": {
            "enum": [
              "landed",
              "pending"
            ]
          },
          "decision": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^D-[0-9]{4}$"
              },
              "owner": {
                "type": "string",
                "pattern": "^https://github.com/flop-labs/flop-core/issues/[0-9]+$"
              },
              "requirements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "owner",
              "requirements"
            ],
            "additionalProperties": false
          },
          "source_issue": {
            "type": "string",
            "pattern": "^https://github.com/flop-labs/(yellowpaper|flop-core)/issues/[0-9]+$"
          },
          "adapter": {
            "enum": [
              "compute-channel",
              "paid-storage-arithmetic",
              null
            ]
          },
          "input": {
            "type": "object",
            "minProperties": 1
          },
          "extrinsics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "call": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "type": "string",
                  "minLength": 1
                },
                "at_block": {
                  "type": "integer",
                  "minimum": 1
                },
                "args": {
                  "type": "object"
                }
              },
              "required": [
                "call",
                "origin",
                "at_block",
                "args"
              ],
              "additionalProperties": false
            }
