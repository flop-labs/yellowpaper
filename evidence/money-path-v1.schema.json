            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "pending_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "family",
          "status",
          "decision",
          "source_issue",
          "adapter",
          "input",
          "extrinsics"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pending"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "expected"
                ]
              },
              "properties": {
                "adapter": {
                  "type": "null"
                },
                "decision": {
                  "properties": {
                    "id": {
                      "type": "null"
                    }
                  }
                }
